{
    "name": "app/task-manager",
    "description": "A lightweight PHP 8.4 task manager.",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "laravel/framework": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "src/"
        ]
    },
    "scripts": {
        "start": "php -S 127.0.0.1:8000 -t public",
        "setup": "php scripts/setup.php",
        "test": "php tests/run.php"
    }
}
